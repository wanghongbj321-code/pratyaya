{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group_meta.schema.json",
  "title": "Pratyaya Workshop Group Meta",
  "type": "object",
  "required": ["schema_version", "group_id", "created_at"],
  "properties": {
    "schema_version": {
      "const": "2.4-group-meta-1"
    },
    "group_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "group_name": {
      "type": "string",
      "minLength": 1
    },
    "group_lead": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}

                  },
                  "original_result": {
                    "enum": ["pass", "fail"]
                  },
                  "risk_level": {
                    "enum": ["low", "medium", "high"]
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "mitigation": {

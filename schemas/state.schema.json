              "confirmation_mode": { "const": null }
            }
          }
        }
      ]
    },
    "persona_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "properties": {
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^PERSONA-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journey_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "properties": {
            "override_audit": {

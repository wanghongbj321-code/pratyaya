        },
        "status": {
          "enum": [
            "draft",
            "gaps_open",
            "review_ready",
            "confirmed",
            "rendered"
          ]
        },
        "gate_recommendation": {
          "enum": ["pass", "fail", "pending"]
        },
        "render_authorized": {
          "type": "boolean"
        },
        "confirmation_mode": {
          "type": ["string", "null"],
          "enum": ["gate_pass", "override", null]
        },
        "output_file": {
          "type": ["string", "null"]
        },
        "content_hash": {
          "type": ["string", "null"]
        },
        "override_audit": {

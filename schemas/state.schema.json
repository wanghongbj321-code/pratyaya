              "confirmation_mode": { "const": null }
            }
          }
        }
      ]
    },
    "persona": {
      "$ref": "#/$defs/persona_state"
    },
    "journey": {
      "$ref": "#/$defs/journey_state"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "anyOf": [
    { "required": ["modules"] },
    { "required": ["golden_circle"] },
    { "required": ["hmw"] },
    { "required": ["persona"] },
    { "required": ["journey"] }
  ],
  "$defs": {
    "single_canvas_state_base": {
      "type": "object",
      "required": [
        "version",
        "status",
        "gate_recommendation",
        "render_authorized",
        "confirmation_mode"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "draft",
            "gaps_open",
            "review_ready",
            "confirmed",
            "rendered"
          ]
        },
        "gate_recommendation": {
          "enum": ["pass", "fail", "pending"]
        },
        "render_authorized": {
          "type": "boolean"
        },
        "confirmation_mode": {
          "type": ["string", "null"],
          "enum": ["gate_pass", "override", null]
        },
        "output_file": {
          "type": ["string", "null"]
        },
        "content_hash": {
          "type": ["string", "null"]
        },
        "override_audit": {
          "type": "object",
          "required": [
            "version",
            "items",
            "reason",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Pratyaya Workshop State",
  "type": "object",
  "required": [
    "schema_version",
    "group_id",
    "project_name",
    "project_slug",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.3"
    },
    "group_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "group_id must be kebab-case ASCII (max 64 chars), matching the {group_id} directory name"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "project_slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "project_slug must be kebab-case ASCII (max 64 chars), matching workshop/{project_slug}"
    },
    "current_module": {
      "enum": ["M1", "M2", "M3", "M4", "M5", "M6"]
    },
    "modules": {
      "type": "object",
      "required": ["M1", "M2", "M3", "M4", "M5", "M6"],
      "additionalProperties": false,
      "patternProperties": {
        "^M[1-6]$": {
          "type": "object",
          "required": [
            "version",
            "status",
            "gate_recommendation",
            "render_authorized",
            "confirmation_mode"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "enum": [
                "draft",
                "gaps_open",
                "review_ready",
                "confirmed",
                "rendered"
              ]
            },
            "gate_recommendation": {
              "enum": ["pass", "fail", "pending"]
            },
            "render_authorized": {
              "type": "boolean"
            },
            "confirmation_mode": {
              "type": ["string", "null"],
              "enum": ["gate_pass", "override", null]
            },
            "module_record": {
              "type": ["string", "null"]
            },
            "output_file": {
              "type": ["string", "null"]
            },
            "content_hash": {
              "type": ["string", "null"]
            },
            "override_audit": {
              "type": "object",
              "required": [
                "version",
                "items",
                "reason",
                "confirmed_by",
                "confirmed_at"
              ],
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "assessment_id",
                      "category",
                      "source_id",
                      "original_result",
                      "risk_level",
                      "impact"
                    ],
                    "properties": {
                      "assessment_id": {
                        "type": "string",
                        "pattern": "^(M[1-6]|GC)-GATE-[0-9]+$"
                      },
                      "category": {
                        "enum": [
                          "information_integrity",
                          "business_risk"
                        ]
                      },
                      "source_id": {
                        "type": "string"
                      },
                      "original_result": {
                        "enum": ["pass", "fail"]
                      },
                      "risk_level": {
                        "enum": ["low", "medium", "high"]
                      },
                      "impact": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "mitigation": {
                  "type": "string"
                },
                "confirmed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed_role": {
                  "type": ["string", "null"]
                },
                "confirmed_at": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "confirmation_mode": { "const": "override" }
                },
                "required": ["confirmation_mode"]
              },
              "then": {
                "properties": {
                  "gate_recommendation": { "const": "fail" },
                  "render_authorized": { "const": true }
                },
                "required": ["override_audit"]
              }
            },
            {
              "if": {
                "properties": {
                  "confirmation_mode": { "const": "gate_pass" }
                },
                "required": ["confirmation_mode"]
              },
              "then": {
                "properties": {
                  "gate_recommendation": { "const": "pass" },
                  "render_authorized": { "const": true }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": ["draft", "gaps_open", "review_ready"]
                  }
                },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "render_authorized": { "const": false },
                  "confirmation_mode": { "const": null }
                }
              }
            }
          ]
        }
      }
    },
    "golden_circle": {
      "type": "object",
      "required": [
        "version",
        "status",
        "gate_recommendation",
        "render_authorized",
        "confirmation_mode"

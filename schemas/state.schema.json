              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "assessment_id",
                  "category",
                  "source_id",
                  "original_result",
                  "risk_level",
                  "impact"
                ],
                "properties": {
                  "assessment_id": {
                    "type": "string",
                    "pattern": "^HMW-GATE-[0-9]+$"
                  },
                  "category": {
                    "const": "business_risk"
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "original_result": {
                    "enum": ["pass", "fail"]
                  },
                  "risk_level": {
                    "enum": ["low", "medium", "high"]
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "mitigation": {
              "type": "string"
            },
            "confirmed_by": {
              "type": "string",

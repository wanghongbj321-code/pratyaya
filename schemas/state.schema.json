{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Pratyaya Workshop State",
  "type": "object",
  "required": [
    "schema_version",
    "group_id",
    "project_name",
    "project_slug",
    "topic_name",
    "topic_slug",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "group_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "group_id must be kebab-case ASCII (max 64 chars), matching workshop/{project_slug}/{group_id}"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "project_slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "project_slug must be kebab-case ASCII (max 64 chars), matching workshop/{project_slug}"
    },
    "topic_name": {
      "type": "string",
      "minLength": 1
    },
    "topic_slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "topic_slug must be kebab-case ASCII (max 64 chars), matching workshop/{project_slug}/{group_id}/{topic_slug}"
    },
    "current_module": {
      "enum": ["M1", "M2", "M3", "M4", "M5", "M6"]
    },
    "_meta": {
      "type": "object",
      "properties": {
        "instance_map_schema_version": {
          "const": "2.6-instance-map-1"
        },
        "v2c_vac_schema_version": {
          "const": "3.0-v2c-vac-1"
        }
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "object",
      "required": ["M1", "M2", "M3", "M4", "M5", "M6"],
      "additionalProperties": false,
      "patternProperties": {
        "^M[1-6]$": {
          "type": "object",
          "required": [
            "version",
            "status",
            "gate_recommendation",
            "render_authorized",
            "confirmation_mode"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "enum": [
                "draft",
                "gaps_open",
                "review_ready",
                "confirmed",
                "rendered"
              ]
            },
            "gate_recommendation": {
              "enum": ["pass", "fail", "pending"]
            },
            "render_authorized": {
              "type": "boolean"
            },
            "confirmation_mode": {
              "type": ["string", "null"],
              "enum": ["gate_pass", "override", null]
            },
            "module_record": {
              "type": ["string", "null"]
            },
            "output_file": {
              "type": ["string", "null"]
            },
            "content_hash": {
              "type": ["string", "null"]
            },
            "override_audit": {
              "type": "object",
              "required": [
                "version",
                "items",
                "reason",
                "confirmed_by",
                "confirmed_at"
              ],
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "assessment_id",
                      "category",
                      "source_id",
                      "original_result",
                      "risk_level",
                      "impact"
                    ],
                    "properties": {
                      "assessment_id": {
                        "type": "string",
                        "pattern": "^(M[1-6]|GC)-GATE-[0-9]+$"
                      },
                      "category": {
                        "enum": [
                          "information_integrity",
                          "business_risk"
                        ]
                      },
                      "source_id": {
                        "type": "string"
                      },
                      "original_result": {
                        "enum": ["pass", "fail"]
                      },
                      "risk_level": {
                        "enum": ["low", "medium", "high"]
                      },
                      "impact": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "mitigation": {
                  "type": "string"
                },
                "confirmed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmed_role": {
                  "type": ["string", "null"]
                },
                "confirmed_at": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "confirmation_mode": { "const": "override" }
                },
                "required": ["confirmation_mode"]
              },
              "then": {
                "properties": {
                  "gate_recommendation": { "const": "fail" },
                  "render_authorized": { "const": true }
                },
                "required": ["override_audit"]
              }
            },
            {
              "if": {
                "properties": {
                  "confirmation_mode": { "const": "gate_pass" }
                },
                "required": ["confirmation_mode"]
              },
              "then": {
                "properties": {
                  "gate_recommendation": { "const": "pass" },
                  "render_authorized": { "const": true }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": ["draft", "gaps_open", "review_ready"]
                  }
                },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "render_authorized": { "const": false },
                  "confirmation_mode": { "const": null }
                }
              }
            }
          ]
        }
      }
    },
    "golden_circle": {
      "$ref": "#/$defs/gc_instance_map"
    },
    "hmw": {
      "$ref": "#/$defs/hmw_instance_map"
    },
    "persona": {
      "$ref": "#/$defs/persona_instance_map"
    },
    "journey": {
      "$ref": "#/$defs/journey_instance_map"
    },
    "maau": {
      "$ref": "#/$defs/maau_instance_map",
      "description": "MAAU 全局画布一次性综合提炼源包实例 map（generation_path=transcript-direct）。每个 slug 一个源包实例，与 M1-M6 Phase 2 全局汇总互斥隔离；不使用 legacy `default` slug。"
    },
    "v2c_vac": {
      "$ref": "#/$defs/v2c_vac_instance_map",
      "description": "V2C Value Attribution Canvas 实例 map。每个 slug 一个 V2C VAC 价值归因画布实例，支持 generation_path=pipeline 或 transcript-direct；不使用 legacy `default` slug。"
    },
    "five_whys": {
      "$ref": "#/$defs/five_whys_instance_map",
      "description": "5W（Five Whys，根因分析）Canvas 实例 map。每个 slug 一个 5W 根因分析画布实例；不使用 legacy `default` slug。"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "anyOf": [
    { "required": ["modules"] },
    { "required": ["golden_circle"] },
    { "required": ["hmw"] },
    { "required": ["persona"] },
    { "required": ["journey"] },
    { "required": ["maau"] },
    { "required": ["v2c_vac"] },
    { "required": ["five_whys"] }
  ],
  "$defs": {
    "single_canvas_state_base": {
      "type": "object",
      "required": [
        "version",
        "status",
        "gate_recommendation",
        "render_authorized",
        "confirmation_mode"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "draft",
            "gaps_open",
            "review_ready",
            "confirmed",
            "rendered"
          ]
        },
        "gate_recommendation": {
          "enum": ["pass", "fail", "pending"]
        },
        "render_authorized": {
          "type": "boolean"
        },
        "confirmation_mode": {
          "type": ["string", "null"],
          "enum": ["gate_pass", "override", null]
        },
        "slug": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "source_file": {
          "type": ["string", "null"]
        },
        "output_file": {
          "type": ["string", "null"]
        },
        "content_hash": {
          "type": ["string", "null"]
        },
        "override_audit": {
          "type": "object",
          "required": [
            "version",
            "items",
            "reason",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "assessment_id",
                  "category",
                  "source_id",
                  "original_result",
                  "risk_level",
                  "impact"
                ],
                "properties": {
                  "assessment_id": {
                    "type": "string"
                  },
                  "category": {
                    "const": "business_risk"
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "original_result": {
                    "enum": ["pass", "fail"]
                  },
                  "risk_level": {
                    "enum": ["low", "medium", "high"]
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "mitigation": {
              "type": "string"
            },
            "confirmed_by": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_role": {
              "type": ["string", "null"]
            },
            "confirmed_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation_mode": { "const": "override" }
            },
            "required": ["confirmation_mode"]
          },
          "then": {
            "properties": {
              "gate_recommendation": { "const": "fail" },
              "render_authorized": { "const": true }
            },
            "required": ["override_audit"]
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_mode": { "const": "gate_pass" }
            },
            "required": ["confirmation_mode"]
          },
          "then": {
            "properties": {
              "gate_recommendation": { "const": "pass" },
              "render_authorized": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["draft", "gaps_open", "review_ready"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "render_authorized": { "const": false },
              "confirmation_mode": { "const": null }
            }
          }
        }
      ]
    },
    "gc_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/gc_instance_state"
        }
      },
      "additionalProperties": false
    },
    "hmw_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/hmw_instance_state"
        }
      },
      "additionalProperties": false
    },
    "persona_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/persona_instance_state"
        }
      },
      "additionalProperties": false
    },
    "journey_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/journey_instance_state"
        }
      },
      "additionalProperties": false
    },
    "gc_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug"],
          "properties": {
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^GC-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "hmw_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug"],
          "properties": {
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^HMW-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "persona_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug"],
          "properties": {
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^PERSONA-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journey_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug"],
          "properties": {
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^JOURNEY-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "v2c_vac_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "not": { "const": "default" }
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/v2c_vac_instance_state"
        }
      },
      "additionalProperties": false,
      "description": "V2C VAC 实例 map。map key 必须为 kebab-case ASCII，且不得为 `default`（V2C VAC 没有 legacy default，新建 slug 必须语义化命名）。"
    },
    "v2c_vac_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug", "generation_path", "pipeline_stage"],
          "properties": {
            "generation_path": {
              "enum": ["pipeline", "transcript-direct"],
              "description": "V2C VAC 生成路径：pipeline 为多阶段管道；transcript-direct 为逐字稿 / 会议材料一次性综合。"
            },
            "pipeline_stage": {
              "type": ["string", "null"],
              "enum": [
                "scenario",
                "capability",
                "change",
                "impact",
                "value",
                "attribution_review",
                null
              ],
              "description": "仅 pipeline 模式用于标记当前阶段；transcript-direct 必须为 null。"
            },
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^V2C-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "generation_path": { "const": "transcript-direct" }
                },
                "required": ["generation_path"]
              },
              "then": {
                "properties": {
                  "pipeline_stage": { "const": null }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "generation_path": { "const": "pipeline" },
                  "status": {
                    "enum": ["draft", "gaps_open", "review_ready"]
                  }
                },
                "required": ["generation_path", "status"]
              },
              "then": {
                "properties": {
                  "pipeline_stage": {
                    "enum": [
                      "scenario",
                      "capability",
                      "change",
                      "impact",
                      "value",
                      "attribution_review"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "maau_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "not": { "const": "default" }
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/maau_instance_state"
        }
      },
      "additionalProperties": false,
      "description": "MAAU 一次性综合源包实例 map。map key 必须为 kebab-case ASCII，且不得为 `default`（MAAU 不走 legacy default，新建 slug 必须语义化命名）。"
    },
    "maau_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug", "generation_path"],
          "properties": {
            "generation_path": {
              "const": "transcript-direct",
              "description": "MAAU 实例的生成路径；本计划仅支持一次性逐字稿综合提炼（transcript-direct），不得使用其他值。"
            },
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^MAAU-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "five_whys_instance_map": {
      "type": "object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "not": { "const": "default" }
      },
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/five_whys_instance_state"
        }
      },
      "additionalProperties": false,
      "description": "5W 根因分析实例 map。map key 必须为 kebab-case ASCII，且不得为 `default`（5W 没有 legacy default，新建 slug 必须语义化命名）。"
    },
    "five_whys_instance_state": {
      "allOf": [
        { "$ref": "#/$defs/single_canvas_state_base" },
        {
          "required": ["slug"],
          "properties": {
            "override_audit": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "assessment_id": {
                        "pattern": "^5W-GATE-[0-9]+$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

            },
            "confirmed_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation_mode": { "const": "override" }
            },
            "required": ["confirmation_mode"]
          },
          "then": {

        },
        "output_file": {
          "type": ["string", "null"]
        },
        "content_hash": {
          "type": ["string", "null"]
        },
        "override_audit": {
          "type": "object",
          "required": [
            "version",
            "items",
            "reason",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "assessment_id",
                  "category",
                  "source_id",
                  "original_result",
                  "risk_level",
                  "impact"
                ],
                "properties": {
                  "assessment_id": {
                    "type": "string",
                    "pattern": "^GC-GATE-[0-9]+$"
                  },
                  "category": {
                    "const": "business_risk"
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "original_result": {
                    "enum": ["pass", "fail"]
                  },
                  "risk_level": {
                    "enum": ["low", "medium", "high"]
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "mitigation": {
              "type": "string"
            },
            "confirmed_by": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_role": {
              "type": ["string", "null"]
            },
            "confirmed_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation_mode": { "const": "override" }
            },
            "required": ["confirmation_mode"]
          },
          "then": {
            "properties": {
              "gate_recommendation": { "const": "fail" },
              "render_authorized": { "const": true }
            },
            "required": ["override_audit"]
          }
        },
        {
          "if": {
            "properties": {
              "confirmation_mode": { "const": "gate_pass" }
            },
            "required": ["confirmation_mode"]
          },
          "then": {
            "properties": {
              "gate_recommendation": { "const": "pass" },
              "render_authorized": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["draft", "gaps_open", "review_ready"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "render_authorized": { "const": false },
              "confirmation_mode": { "const": null }
            }
          }
        }
      ]
    },
